{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.4 --activate && cd ../.. && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build:full",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/index.ts": {
      "maxDuration": 120,
      "memory": 1024
    }
  }
}
